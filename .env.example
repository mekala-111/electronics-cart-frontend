# Public API base (must include /api suffix).
# Locally prefer the same-origin rewrite to avoid CORS:
#   NEXT_PUBLIC_API_URL=/backend-api
#   API_PROXY_TARGET=https://api.gdcd.online/api
NEXT_PUBLIC_API_URL=https://api.gdcd.online/api

# Upstream for Next.js /backend-api rewrite (server-only; not exposed to the browser)
# API_PROXY_TARGET=https://api.gdcd.online/api

# Canonical site origin for SEO metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://ecartlaptops.com

# Development only — ignored in production builds
# NEXT_PUBLIC_ALLOW_DEMO_AUTH=true
# NEXT_PUBLIC_ALLOW_API_FALLBACKS=false

# Firebase Auth (web app config — public by design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Razorpay Checkout.js (public key only). Required when API has PAYMENTS_SERVER_CAPTURE=false.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
